rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return signedIn()
        && get(/databases/$(database)/documents/usuarios/$(request.auth.uid)).data.rol == 'admin'
        && get(/databases/$(database)/documents/usuarios/$(request.auth.uid)).data.activo == true;
    }

    function isPsychologist(uid) {
      return signedIn()
        && request.auth.uid == uid
        && get(/databases/$(database)/documents/usuarios/$(uid)).data.rol == 'psicologo'
        && get(/databases/$(database)/documents/usuarios/$(uid)).data.activo == true;
    }

    function isActivePsychologist(uid) {
      let userPath = /databases/$(database)/documents/usuarios/$(uid);
      return exists(userPath)
        && get(userPath).data.rol == 'psicologo'
        && get(userPath).data.activo == true;
    }

    function isActivePatient(uid) {
      return signedIn()
        && request.auth.uid == uid
        && get(/databases/$(database)/documents/usuarios/$(uid)).data.rol == 'paciente'
        && get(/databases/$(database)/documents/usuarios/$(uid)).data.activo == true;
    }

    function isAdminOrPaymentProfessional(pagoId) {
      let paymentPath = /databases/$(database)/documents/pagos/$(pagoId);
      return isAdmin()
        || (signedIn() && existsAfter(paymentPath)
          && getAfter(paymentPath).data.psicologoId == request.auth.uid)
        || (signedIn() && existsAfter(paymentPath)
          && getAfter(paymentPath).data.pacienteId == request.auth.uid);
    }

    function ownsProfile(uid) {
      return signedIn() && request.auth.uid == uid;
    }

    function validDeclaredDni(data) {
      return data.dni is string && data.dni.matches('^[0-9]{8}$');
    }

    function allowedPatientProfileKeys(data) {
      return data.keys().hasOnly([
        'nombres', 'apellidos', 'correo', 'telefono', 'rol', 'activo',
        'fechaRegistro', 'fotoUrl', 'dni', 'nombre', 'email', 'uid'
      ]);
    }

    function twoDigits(value) {
      return value < 10 ? '0' + string(value) : string(value);
    }

    function validSchedule(scheduleId, data) {
      let schedulePath = /databases/$(database)/documents/horariosLaborales/$(scheduleId);
      let psychologistPath = /databases/$(database)/documents/psicologos/$(data.psicologoId);
      let sitePath = /databases/$(database)/documents/sedes/$(data.sedeId);
      let specialtyPath = /databases/$(database)/documents/especialidades/$(data.especialidadId);
      let startLocal = data.inicioAt - duration.value(5, 'h');
      let localDate = string(startLocal.year()) + '-' + twoDigits(startLocal.month()) + '-' + twoDigits(startLocal.day());
      let localTime = twoDigits(startLocal.hours()) + ':' + twoDigits(startLocal.minutes());
      return scheduleId == data.psicologoId + '~' + data.sedeId
        && data.horarioId == scheduleId
        && data.slotId == string(data.inicioAt.toMillis())
        && data.inicioEpochMillis == data.inicioAt.toMillis()
        && data.duracionMinutos == 60
        && data.inicioAt > request.time
        && data.fecha == localDate
        && data.hora == localTime
        && startLocal.dayOfWeek() >= 1 && startLocal.dayOfWeek() <= 7
        && get(schedulePath).data.activo == true
        && get(schedulePath).data.zonaHoraria == 'America/Lima'
        && get(schedulePath).data.psicologoId == data.psicologoId
        && get(schedulePath).data.sedeId == data.sedeId
        && get(schedulePath).data.duracionMinutos == data.duracionMinutos
        && get(psychologistPath).data.activo == true
        && data.sedeId in get(psychologistPath).data.sedeIds
        && data.especialidadId in get(psychologistPath).data.especialidadIds
        && get(sitePath).data.activa == true
        && get(specialtyPath).data.activa == true;
    }

    function validBlock(scheduleId, data) {
      let blockPath = /databases/$(database)/documents/horariosLaborales/$(scheduleId)/bloques/$(data.bloqueId);
      let startLocal = data.inicioAt - duration.value(5, 'h');
      let startMinute = startLocal.hours() * 60 + startLocal.minutes();
      return get(blockPath).data.activo == true
        && get(blockPath).data.diaSemana == startLocal.dayOfWeek()
        && startMinute >= get(blockPath).data.inicioMinuto
        && startMinute + data.duracionMinutos <= get(blockPath).data.finMinuto
        && (startMinute - get(blockPath).data.inicioMinuto) % data.duracionMinutos == 0;
    }

    function validException(scheduleId, data) {
      let exceptionId = scheduleId + '~' + data.slotId;
      let exceptionPath = /databases/$(database)/documents/excepcionesHorario/$(exceptionId);
      return !exists(exceptionPath)
        || (get(exceptionPath).data.horarioId == scheduleId
          && get(exceptionPath).data.psicologoId == data.psicologoId
          && get(exceptionPath).data.sedeId == data.sedeId
          && get(exceptionPath).data.fecha == data.fecha
          && get(exceptionPath).data.hora == data.hora
          && get(exceptionPath).data.inicioEpochMillis == data.inicioEpochMillis
          && get(exceptionPath).data.tipo == 'DISPONIBILIDAD_EXTRA');
    }

    function reservationLockAfter(reservationId, data) {
      let lockPath = /databases/$(database)/documents/horariosLaborales/$(data.horarioId)/turnos/$(data.slotId);
      return getAfter(lockPath).data.reservaId == reservationId
        && getAfter(lockPath).data.inicioEpochMillis == data.inicioEpochMillis;
    }

    function appointmentAfter(reservationId, data) {
      let appointmentPath = /databases/$(database)/documents/citas/$(data.citaId);
      return existsAfter(appointmentPath)
        && getAfter(appointmentPath).data.reservaId == reservationId
        && getAfter(appointmentPath).data.pacienteId == data.pacienteId
        && getAfter(appointmentPath).data.slotId == data.slotId
        && getAfter(appointmentPath).data.inicioEpochMillis == data.inicioEpochMillis;
    }

    function patientCanCancel(data) {
      let reservationPath = /databases/$(database)/documents/reservas/$(data.reservaId);
      let reservation = get(reservationPath).data;
      let lockPath = /databases/$(database)/documents/horariosLaborales/$(reservation.horarioId)/turnos/$(reservation.slotId);
      return isActivePatient(data.pacienteId)
        && request.auth.uid == data.pacienteId
        && data.estado == 'PROGRAMADA'
        && (!data.keys().hasAny(['estadoPago']) || data.estadoPago != 'PAGADO')
        && (!data.keys().hasAny(['pagado']) || data.pagado != true)
        && data.inicioAt > request.time + duration.value(24, 'h')
        && exists(reservationPath)
        && reservation.pacienteId == request.auth.uid
        && reservation.estado == 'CONFIRMADA'
        && getAfter(reservationPath).data.estado == 'CANCELADA'
        && !existsAfter(lockPath);
    }

    function reservationAndAppointmentCancelledAfter(reservationId) {
      let reservationPath = /databases/$(database)/documents/reservas/$(reservationId);
      let reservation = getAfter(reservationPath).data;
      let appointmentPath = /databases/$(database)/documents/citas/$(reservation.citaId);
      return reservation.estado == 'CANCELADA'
        && getAfter(appointmentPath).data.estado == 'CANCELADA';
    }

    function validReservationCreate(reservationId) {
      let data = request.resource.data;
      return isActivePatient(data.pacienteId)
        && data.id == reservationId
        && data.estado == 'CONFIRMADA'
        && data.keys().hasOnly([
          'id', 'pacienteId', 'psicologoId', 'sedeId', 'horarioId', 'bloqueId', 'slotId',
          'especialidadId', 'fecha', 'hora', 'inicioEpochMillis', 'inicioAt',
          'duracionMinutos', 'estado', 'citaId', 'creadaEn'
        ])
        && data.creadaEn == request.time
        && validSchedule(data.horarioId, data)
        && validException(data.horarioId, data)
        && (validBlock(data.horarioId, data)
          || (exists(/databases/$(database)/documents/excepcionesHorario/$(data.horarioId + '~' + data.slotId))
            && get(/databases/$(database)/documents/excepcionesHorario/$(data.horarioId + '~' + data.slotId)).data.tipo == 'DISPONIBILIDAD_EXTRA'))
        && reservationLockAfter(reservationId, data)
        && appointmentAfter(reservationId, data);
    }

    match /usuarios/{uid} {
      allow get: if ownsProfile(uid) || isAdmin();
      allow list: if isAdmin();
      allow create: if ownsProfile(uid)
        && request.resource.data.keys().hasOnly([
          'nombres', 'apellidos', 'correo', 'telefono', 'rol', 'activo',
          'fechaRegistro', 'fotoUrl', 'dni'
        ])
        && request.resource.data.nombres is string
        && request.resource.data.nombres.size() > 0
        && request.resource.data.nombres.size() <= 100
        && request.resource.data.apellidos is string
        && request.resource.data.apellidos.size() > 0
        && request.resource.data.apellidos.size() <= 100
        && (!request.resource.data.keys().hasAny(['telefono']) || request.resource.data.telefono is string)
        && (!request.resource.data.keys().hasAny(['fotoUrl']) || request.resource.data.fotoUrl is string)
        && validDeclaredDni(request.resource.data)
        && request.resource.data.correo == request.auth.token.email
        && request.resource.data.rol == 'paciente'
        && request.resource.data.activo == true
        && request.resource.data.fechaRegistro == request.time;
      allow update: if (isAdmin()
          && resource.data.rol == 'paciente'
          && request.resource.data.rol == 'psicologo'
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['rol']))
        || (ownsProfile(uid)
          && resource.data.rol == 'psicologo'
          && resource.data.activo == true
          && request.resource.data.rol == resource.data.rol
          && request.resource.data.activo == resource.data.activo
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['nombres', 'apellidos', 'telefono'])
          && request.resource.data.nombres is string
          && request.resource.data.nombres.size() > 0
          && request.resource.data.nombres.size() <= 100
          && request.resource.data.apellidos is string
          && request.resource.data.apellidos.size() > 0
          && request.resource.data.apellidos.size() <= 100
          && request.resource.data.telefono is string)
        || (ownsProfile(uid)
        && allowedPatientProfileKeys(request.resource.data)
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'nombres', 'apellidos', 'correo', 'telefono', 'fotoUrl', 'fechaRegistro', 'dni', 'rol', 'activo'
        ])
        && request.resource.data.nombres is string
        && request.resource.data.nombres.size() > 0
        && request.resource.data.nombres.size() <= 100
        && request.resource.data.apellidos is string
        && request.resource.data.apellidos.size() > 0
        && request.resource.data.apellidos.size() <= 100
        && validDeclaredDni(request.resource.data)
        && (!request.resource.data.keys().hasAny(['telefono']) || request.resource.data.telefono is string)
        && (!request.resource.data.keys().hasAny(['fotoUrl']) || request.resource.data.fotoUrl is string)
        && (!resource.data.keys().hasAny(['uid']) || resource.data.uid == uid)
        && request.resource.data.correo == request.auth.token.email
        && (!resource.data.keys().hasAny(['rol']) || request.resource.data.rol == resource.data.rol)
        && (!resource.data.keys().hasAny(['rol']) || resource.data.rol == 'paciente')
        && request.resource.data.rol == 'paciente'
        && (!resource.data.keys().hasAny(['activo']) || request.resource.data.activo == resource.data.activo)
        && request.resource.data.activo == true
        && (!resource.data.keys().hasAny(['fechaRegistro'])
          || !(resource.data.fechaRegistro is timestamp)
          || request.resource.data.fechaRegistro == resource.data.fechaRegistro)
        && (!resource.data.keys().hasAny(['dni']) || resource.data.dni == null || request.resource.data.dni == resource.data.dni)
        && ((resource.data.keys().hasAny(['fechaRegistro']) && resource.data.fechaRegistro is timestamp)
          || request.resource.data.fechaRegistro == request.time));
      allow delete: if false;
    }

    match /psicologos/{psicologoId} {
      allow get, list: if signedIn() && resource.data.activo == true;
      allow create: if isAdmin();
      allow update: if isAdmin()
        || (signedIn()
          && request.auth.uid == psicologoId
          && resource.data.usuarioId == request.auth.uid
          && resource.data.activo == true
          && request.resource.data.activo == resource.data.activo
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['nombres', 'apellidos'])
          && request.resource.data.nombres is string
          && request.resource.data.nombres.size() > 0
          && request.resource.data.nombres.size() <= 100
          && request.resource.data.apellidos is string
          && request.resource.data.apellidos.size() > 0
          && request.resource.data.apellidos.size() <= 100);
      allow delete: if false;
    }

    match /especialidades/{especialidadId} {
      allow get, list: if signedIn() && resource.data.activa == true;
      allow write: if false;
    }

    match /sedes/{sedeId} {
      allow get, list: if signedIn() && resource.data.activa == true;
      allow write: if false;
    }

    match /horariosLaborales/{horarioId} {
      allow get, list: if signedIn() && resource.data.activo == true;
      allow create, update: if isAdmin()
        && request.resource.data.psicologoId is string
        && request.resource.data.sedeId is string
        && horarioId == request.resource.data.psicologoId + '~' + request.resource.data.sedeId;
      allow delete: if false;

      match /bloques/{bloqueId} {
        allow get, list: if signedIn() && resource.data.activo == true;
        allow create, update: if isAdmin()
          && request.resource.data.activo is bool
          && request.resource.data.diaSemana is int
          && request.resource.data.diaSemana >= 1
          && request.resource.data.diaSemana <= 7
          && request.resource.data.inicioMinuto is int
          && request.resource.data.finMinuto is int
          && request.resource.data.inicioMinuto >= 0
          && request.resource.data.finMinuto <= 1440
          && request.resource.data.inicioMinuto < request.resource.data.finMinuto;
        allow delete: if isAdmin();
      }

      match /turnos/{slotId} {
        allow get, list: if signedIn();
        allow create: if signedIn()
          && request.resource.data.slotId == slotId
          && request.resource.data.reservaId is string
          && existsAfter(/databases/$(database)/documents/reservas/$(request.resource.data.reservaId))
          && getAfter(/databases/$(database)/documents/reservas/$(request.resource.data.reservaId)).data.horarioId == horarioId
          && getAfter(/databases/$(database)/documents/reservas/$(request.resource.data.reservaId)).data.slotId == slotId
          && (isAdmin() || getAfter(/databases/$(database)/documents/reservas/$(request.resource.data.reservaId)).data.pacienteId == request.auth.uid)
          && getAfter(/databases/$(database)/documents/reservas/$(request.resource.data.reservaId)).data.inicioEpochMillis == request.resource.data.inicioEpochMillis;
        allow update: if false;
        allow delete: if isAdmin() || (signedIn()
          && exists(/databases/$(database)/documents/reservas/$(resource.data.reservaId))
          && get(/databases/$(database)/documents/reservas/$(resource.data.reservaId)).data.pacienteId == request.auth.uid
          && get(/databases/$(database)/documents/reservas/$(resource.data.reservaId)).data.horarioId == horarioId
          && get(/databases/$(database)/documents/reservas/$(resource.data.reservaId)).data.slotId == slotId
          && reservationAndAppointmentCancelledAfter(resource.data.reservaId));
      }
    }

    match /excepcionesHorario/{exceptionId} {
      allow get, list: if signedIn();
      allow create, update: if isAdmin();
      allow delete: if isAdmin();
    }

    match /reservas/{reservaId} {
      allow get, list: if isAdmin() || (signedIn() && resource.data.pacienteId == request.auth.uid);
      allow create: if validReservationCreate(reservaId);
      allow update: if (signedIn()
        && resource.data.pacienteId == request.auth.uid
        && resource.data.estado == 'CONFIRMADA'
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['estado'])
        && request.resource.data.estado == 'CANCELADA'
        && getAfter(/databases/$(database)/documents/citas/$(resource.data.citaId)).data.estado == 'CANCELADA'
        && get(/databases/$(database)/documents/citas/$(resource.data.citaId)).data.inicioAt > request.time + duration.value(24, 'h')
        && (!get(/databases/$(database)/documents/citas/$(resource.data.citaId)).data.keys().hasAny(['estadoPago'])
          || get(/databases/$(database)/documents/citas/$(resource.data.citaId)).data.estadoPago != 'PAGADO')
        && (!get(/databases/$(database)/documents/citas/$(resource.data.citaId)).data.keys().hasAny(['pagado'])
          || get(/databases/$(database)/documents/citas/$(resource.data.citaId)).data.pagado != true))
        || (isAdmin()
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['estado'])
          && request.resource.data.estado == 'CANCELADA')
        || (isAdmin()
          && resource.data.estado == 'CONFIRMADA'
          && request.resource.data.estado == 'CONFIRMADA'
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
            'fecha', 'hora', 'inicioEpochMillis', 'inicioAt', 'slotId', 'bloqueId'
          ])
          && getAfter(/databases/$(database)/documents/citas/$(resource.data.citaId)).data.fecha == request.resource.data.fecha
          && getAfter(/databases/$(database)/documents/citas/$(resource.data.citaId)).data.hora == request.resource.data.hora
          && getAfter(/databases/$(database)/documents/citas/$(resource.data.citaId)).data.slotId == request.resource.data.slotId
          && getAfter(/databases/$(database)/documents/citas/$(resource.data.citaId)).data.inicioEpochMillis == request.resource.data.inicioEpochMillis
          && getAfter(/databases/$(database)/documents/horariosLaborales/$(request.resource.data.horarioId)/turnos/$(request.resource.data.slotId)).data.reservaId == reservaId
          && !existsAfter(/databases/$(database)/documents/horariosLaborales/$(resource.data.horarioId)/turnos/$(resource.data.slotId)));
      allow delete: if false;
    }

    match /citas/{citaId} {
      allow get, list: if signedIn() && (
        resource.data.pacienteId == request.auth.uid
        || resource.data.psicologoId == request.auth.uid
        || isAdmin()
      );
      allow create: if signedIn()
        && request.resource.data.keys().hasOnly([
          'id', 'reservaId', 'pacienteId', 'pacienteNombre', 'psicologoId', 'sedeId', 'especialidadId',
          'slotId', 'fecha', 'hora', 'inicioEpochMillis', 'inicioAt',
          'duracionMinutos', 'estado', 'creadaEn'
        ])
        && request.resource.data.id == citaId
        && request.resource.data.pacienteNombre is string
        && request.resource.data.pacienteNombre.size() > 0
        && request.resource.data.pacienteNombre.size() <= 201
        && request.resource.data.estado == 'PROGRAMADA'
        && request.resource.data.creadaEn == request.time
        && request.resource.data.pacienteId == request.auth.uid
        && existsAfter(/databases/$(database)/documents/reservas/$(request.resource.data.reservaId))
        && getAfter(/databases/$(database)/documents/reservas/$(request.resource.data.reservaId)).data.citaId == citaId
        && getAfter(/databases/$(database)/documents/reservas/$(request.resource.data.reservaId)).data.pacienteId == request.auth.uid
        && getAfter(/databases/$(database)/documents/reservas/$(request.resource.data.reservaId)).data.slotId == request.resource.data.slotId
        && getAfter(/databases/$(database)/documents/reservas/$(request.resource.data.reservaId)).data.psicologoId == request.resource.data.psicologoId
        && getAfter(/databases/$(database)/documents/reservas/$(request.resource.data.reservaId)).data.sedeId == request.resource.data.sedeId
        && getAfter(/databases/$(database)/documents/reservas/$(request.resource.data.reservaId)).data.especialidadId == request.resource.data.especialidadId
        && getAfter(/databases/$(database)/documents/reservas/$(request.resource.data.reservaId)).data.inicioEpochMillis == request.resource.data.inicioEpochMillis
        && getAfter(/databases/$(database)/documents/reservas/$(request.resource.data.reservaId)).data.inicioAt == request.resource.data.inicioAt
        && getAfter(/databases/$(database)/documents/reservas/$(request.resource.data.reservaId)).data.duracionMinutos == request.resource.data.duracionMinutos;
      allow update: if (isAdmin()
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['estado', 'estadoPago', 'pagado', 'canceladaEn']))
        || (isAdmin()
          && resource.data.estado == 'PROGRAMADA'
          && request.resource.data.estado == 'PROGRAMADA'
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
            'fecha', 'hora', 'inicioEpochMillis', 'inicioAt', 'slotId'
          ])
          && existsAfter(/databases/$(database)/documents/reservas/$(resource.data.reservaId))
          && getAfter(/databases/$(database)/documents/reservas/$(resource.data.reservaId)).data.fecha == request.resource.data.fecha
          && getAfter(/databases/$(database)/documents/reservas/$(resource.data.reservaId)).data.hora == request.resource.data.hora
          && getAfter(/databases/$(database)/documents/reservas/$(resource.data.reservaId)).data.inicioEpochMillis == request.resource.data.inicioEpochMillis
          && getAfter(/databases/$(database)/documents/reservas/$(resource.data.reservaId)).data.inicioAt == request.resource.data.inicioAt
          && getAfter(/databases/$(database)/documents/reservas/$(resource.data.reservaId)).data.slotId == request.resource.data.slotId
          && getAfter(/databases/$(database)/documents/horariosLaborales/$(resource.data.psicologoId + '~' + resource.data.sedeId)/turnos/$(request.resource.data.slotId)).data.reservaId == resource.data.reservaId
          && !existsAfter(/databases/$(database)/documents/horariosLaborales/$(resource.data.psicologoId + '~' + resource.data.sedeId)/turnos/$(resource.data.slotId)))
        || (isPsychologist(resource.data.psicologoId)
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['estado'])
          && request.resource.data.estado == 'COMPLETADA'
          && resource.data.estado in ['PROGRAMADA', 'COMPLETADA']
          && resource.data.inicioAt <= request.time)
        || (isPsychologist(resource.data.psicologoId)
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['estado'])
          && request.resource.data.estado == 'NO_ASISTIO'
          && resource.data.estado == 'PROGRAMADA'
          && resource.data.inicioAt + duration.value(resource.data.duracionMinutos, 'm') <= request.time)
        || (isPsychologist(resource.data.psicologoId)
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['estadoPago', 'pagado'])
          && request.resource.data.estadoPago == 'PAGADO'
          && request.resource.data.pagado == true)
        || (signedIn()
          && resource.data.pacienteId == request.auth.uid
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['estadoPago', 'pagado'])
          && (!resource.data.keys().hasAny(['estadoPago']) || resource.data.estadoPago == 'PENDIENTE')
          && request.resource.data.estadoPago == 'PAGADO'
          && request.resource.data.pagado == true)
        || (request.resource.data.diff(resource.data).affectedKeys().hasOnly(['estado', 'canceladaEn'])
          && request.resource.data.estado == 'CANCELADA'
          && patientCanCancel(resource.data));
      allow delete: if false;
    }

    match /solicitudesGestionCitas/{solicitudId} {
      allow get: if isAdmin() || (signedIn() && (
        (!exists(/databases/$(database)/documents/solicitudesGestionCitas/$(solicitudId))
          && exists(/databases/$(database)/documents/citas/$(solicitudId))
          && get(/databases/$(database)/documents/citas/$(solicitudId)).data.pacienteId == request.auth.uid)
        || (exists(/databases/$(database)/documents/solicitudesGestionCitas/$(solicitudId))
          && resource.data.pacienteId == request.auth.uid)
      ));
      allow list: if isAdmin() || (signedIn() && resource.data.pacienteId == request.auth.uid);
      allow create: if isActivePatient(request.resource.data.pacienteId)
        && request.resource.data.id == solicitudId
        && request.resource.data.citaId == solicitudId
        && request.resource.data.keys().hasOnly([
          'id', 'citaId', 'pacienteId', 'psicologoId', 'tipo', 'estado', 'creadaEn',
          'fechaSolicitada', 'horaSolicitada', 'inicioEpochMillisSolicitado',
          'horarioIdSolicitado', 'bloqueIdSolicitado', 'duracionMinutosSolicitada'
        ])
        && request.resource.data.tipo in ['CANCELACION', 'REPROGRAMACION']
        && request.resource.data.estado == 'PENDIENTE'
        && request.resource.data.creadaEn == request.time
        && exists(/databases/$(database)/documents/citas/$(request.resource.data.citaId))
        && get(/databases/$(database)/documents/citas/$(request.resource.data.citaId)).data.pacienteId == request.auth.uid
        && get(/databases/$(database)/documents/citas/$(request.resource.data.citaId)).data.psicologoId == request.resource.data.psicologoId
        && get(/databases/$(database)/documents/citas/$(request.resource.data.citaId)).data.estado == 'PROGRAMADA'
        && get(/databases/$(database)/documents/citas/$(request.resource.data.citaId)).data.inicioEpochMillis > request.time.toMillis()
        && ((request.resource.data.tipo == 'CANCELACION'
            && !request.resource.data.keys().hasAny([
              'fechaSolicitada', 'horaSolicitada', 'inicioEpochMillisSolicitado',
              'horarioIdSolicitado', 'bloqueIdSolicitado', 'duracionMinutosSolicitada'
            ]))
          || (request.resource.data.tipo == 'REPROGRAMACION'
            && request.resource.data.keys().hasAll([
              'fechaSolicitada', 'horaSolicitada', 'inicioEpochMillisSolicitado',
              'horarioIdSolicitado', 'bloqueIdSolicitado', 'duracionMinutosSolicitada'
            ])
            && request.resource.data.fechaSolicitada is string
            && request.resource.data.horaSolicitada is string
            && request.resource.data.inicioEpochMillisSolicitado is int
            && request.resource.data.inicioEpochMillisSolicitado > request.time.toMillis()
            && request.resource.data.horarioIdSolicitado == request.resource.data.psicologoId + '~' + get(/databases/$(database)/documents/citas/$(solicitudId)).data.sedeId
            && request.resource.data.bloqueIdSolicitado is string
            && request.resource.data.duracionMinutosSolicitada == get(/databases/$(database)/documents/citas/$(solicitudId)).data.duracionMinutos
            && request.resource.data.inicioEpochMillisSolicitado != get(/databases/$(database)/documents/citas/$(solicitudId)).data.inicioEpochMillis));
      allow update: if (isAdmin()
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['estado', 'resueltaEn', 'resueltaPor', 'notaAdmin', 'pagoPendienteRevision'])
          && request.resource.data.estado in ['ACEPTADA', 'RECHAZADA', 'ATENDIDA'])
        || (isActivePatient(resource.data.pacienteId)
          && resource.data.pacienteId == request.auth.uid
          && resource.data.citaId == solicitudId
          && resource.data.estado in ['ACEPTADA', 'RECHAZADA', 'ATENDIDA']
          && request.resource.data.id == solicitudId
          && request.resource.data.citaId == solicitudId
          && request.resource.data.pacienteId == request.auth.uid
          && request.resource.data.psicologoId == resource.data.psicologoId
          && request.resource.data.tipo in ['CANCELACION', 'REPROGRAMACION']
          && request.resource.data.estado == 'PENDIENTE'
          && request.resource.data.creadaEn == request.time
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
            'tipo', 'estado', 'creadaEn', 'resueltaEn', 'resueltaPor', 'notaAdmin', 'pagoPendienteRevision',
            'fechaSolicitada', 'horaSolicitada', 'inicioEpochMillisSolicitado',
            'horarioIdSolicitado', 'bloqueIdSolicitado', 'duracionMinutosSolicitada'
          ])
          && exists(/databases/$(database)/documents/citas/$(solicitudId))
          && get(/databases/$(database)/documents/citas/$(solicitudId)).data.pacienteId == request.auth.uid
          && get(/databases/$(database)/documents/citas/$(solicitudId)).data.estado == 'PROGRAMADA'
          && get(/databases/$(database)/documents/citas/$(solicitudId)).data.inicioEpochMillis > request.time.toMillis()
          && ((request.resource.data.tipo == 'CANCELACION'
              && !request.resource.data.keys().hasAny([
                'fechaSolicitada', 'horaSolicitada', 'inicioEpochMillisSolicitado',
                'horarioIdSolicitado', 'bloqueIdSolicitado', 'duracionMinutosSolicitada'
              ]))
            || (request.resource.data.tipo == 'REPROGRAMACION'
              && request.resource.data.keys().hasAll([
                'fechaSolicitada', 'horaSolicitada', 'inicioEpochMillisSolicitado',
                'horarioIdSolicitado', 'bloqueIdSolicitado', 'duracionMinutosSolicitada'
              ])
              && request.resource.data.fechaSolicitada is string
              && request.resource.data.horaSolicitada is string
              && request.resource.data.inicioEpochMillisSolicitado is int
              && request.resource.data.inicioEpochMillisSolicitado > request.time.toMillis()
              && request.resource.data.horarioIdSolicitado == request.resource.data.psicologoId + '~' + get(/databases/$(database)/documents/citas/$(solicitudId)).data.sedeId
              && request.resource.data.bloqueIdSolicitado is string
              && request.resource.data.duracionMinutosSolicitada == get(/databases/$(database)/documents/citas/$(solicitudId)).data.duracionMinutos
              && request.resource.data.inicioEpochMillisSolicitado != get(/databases/$(database)/documents/citas/$(solicitudId)).data.inicioEpochMillis)));
      allow delete: if false;
    }

    match /pagos/{pagoId} {
      allow get, list: if signedIn() && (
        resource.data.pacienteId == request.auth.uid
        || resource.data.psicologoId == request.auth.uid
        || isAdmin()
      );
      allow create: if isActivePatient(request.resource.data.pacienteId)
        && request.resource.data.id == pagoId
        && request.resource.data.estado == 'PENDIENTE'
        && request.resource.data.keys().hasOnly([
          'id', 'citaId', 'pacienteId', 'psicologoId', 'monto', 'moneda', 'estado', 'creadaEn'
        ])
        && request.resource.data.creadaEn == request.time
        && exists(/databases/$(database)/documents/citas/$(request.resource.data.citaId))
        && get(/databases/$(database)/documents/citas/$(request.resource.data.citaId)).data.pacienteId == request.resource.data.pacienteId
        && get(/databases/$(database)/documents/citas/$(request.resource.data.citaId)).data.psicologoId == request.resource.data.psicologoId;
      allow update: if isAdmin()
        || (isPsychologist(resource.data.psicologoId)
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
            'estado', 'metodoPago', 'referenciaTransaccion', 'actualizadaEn'
          ])
          && resource.data.estado == 'PENDIENTE'
          && request.resource.data.estado == 'PAGADO')
        || (signedIn()
          && resource.data.pacienteId == request.auth.uid
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
            'estado', 'metodoPago', 'referenciaTransaccion', 'actualizadaEn'
          ])
          && resource.data.estado == 'PENDIENTE'
          && (request.resource.data.estado == 'PENDIENTE'
            || (request.resource.data.estado == 'PAGADO'
              && request.resource.data.metodoPago == 'ONLINE_MERCADOPAGO'
              && request.resource.data.referenciaTransaccion is string)));
      allow delete: if false;
    }

    match /notificaciones/{notificacionId} {
      allow get, list: if (isAdmin() && resource.data.destinatarioRol == 'admin')
        || (signedIn() && resource.data.usuarioId == request.auth.uid);
      allow create: if signedIn()
        && request.resource.data.id == notificacionId
        && request.resource.data.keys().hasOnly([
          'id', 'usuarioId', 'destinatarioRol', 'titulo', 'mensaje', 'tipo',
          'citaId', 'pagoId', 'solicitudId', 'fechaCreacion', 'leida'
        ])
        && request.resource.data.titulo is string
        && request.resource.data.mensaje is string
        && request.resource.data.fechaCreacion == request.time
        && request.resource.data.leida == false
        && (
          (request.resource.data.tipo == 'PAGO_CONFIRMADO'
            && request.resource.data.destinatarioRol == 'paciente'
            && request.resource.data.usuarioId == getAfter(/databases/$(database)/documents/pagos/$(request.resource.data.pagoId)).data.pacienteId
            && isAdminOrPaymentProfessional(request.resource.data.pagoId)
            && getAfter(/databases/$(database)/documents/pagos/$(request.resource.data.pagoId)).data.estado == 'PAGADO'
            && getAfter(/databases/$(database)/documents/pagos/$(request.resource.data.pagoId)).data.citaId == request.resource.data.citaId)
          || (request.resource.data.tipo == 'PAGO_CONFIRMADO_ADMIN'
            && request.resource.data.destinatarioRol == 'admin'
            && isAdminOrPaymentProfessional(request.resource.data.pagoId)
            && getAfter(/databases/$(database)/documents/pagos/$(request.resource.data.pagoId)).data.estado == 'PAGADO'
            && getAfter(/databases/$(database)/documents/pagos/$(request.resource.data.pagoId)).data.citaId == request.resource.data.citaId)
          || (request.resource.data.tipo == 'SOLICITUD_GESTION'
            && request.resource.data.destinatarioRol == 'admin'
            && existsAfter(/databases/$(database)/documents/solicitudesGestionCitas/$(request.resource.data.solicitudId))
            && getAfter(/databases/$(database)/documents/solicitudesGestionCitas/$(request.resource.data.solicitudId)).data.estado == 'PENDIENTE'
            && getAfter(/databases/$(database)/documents/solicitudesGestionCitas/$(request.resource.data.solicitudId)).data.pacienteId == request.auth.uid)
          || (request.resource.data.tipo == 'CITA_RESERVADA_PSICOLOGO'
            && request.resource.data.destinatarioRol == 'psicologo'
            && isActivePsychologist(request.resource.data.usuarioId)
            && existsAfter(/databases/$(database)/documents/citas/$(request.resource.data.citaId))
            && getAfter(/databases/$(database)/documents/citas/$(request.resource.data.citaId)).data.psicologoId == request.resource.data.usuarioId
            && getAfter(/databases/$(database)/documents/citas/$(request.resource.data.citaId)).data.pacienteId == request.auth.uid
            && isActivePatient(request.auth.uid))
          || (request.resource.data.tipo in ['GESTION_REPROGRAMADA', 'GESTION_CANCELADA', 'GESTION_RECHAZADA']
            && request.resource.data.destinatarioRol == 'paciente'
            && isAdmin()
            && request.resource.data.usuarioId == getAfter(/databases/$(database)/documents/solicitudesGestionCitas/$(request.resource.data.solicitudId)).data.pacienteId
            && getAfter(/databases/$(database)/documents/solicitudesGestionCitas/$(request.resource.data.solicitudId)).data.estado in ['ACEPTADA', 'RECHAZADA'])
        );
      allow update, delete: if false;
    }

    match /comprobantes/{comprobanteId} {
      allow get, list: if signedIn() && (
        resource.data.pacienteId == request.auth.uid
        || get(/databases/$(database)/documents/pagos/$(resource.data.pagoId)).data.psicologoId == request.auth.uid
        || isAdmin()
      );
      allow create: if signedIn()
        && request.resource.data.id == comprobanteId
        && request.resource.data.keys().hasOnly([
          'id', 'pagoId', 'citaId', 'pacienteId', 'psicologoId', 'monto', 'moneda',
          'fechaEmision', 'tipo', 'numeroComprobante', 'detalles', 'creadaEn'
        ])
        && request.resource.data.creadaEn == request.time
        && existsAfter(/databases/$(database)/documents/pagos/$(request.resource.data.pagoId))
        && getAfter(/databases/$(database)/documents/pagos/$(request.resource.data.pagoId)).data.estado == 'PAGADO'
        && getAfter(/databases/$(database)/documents/pagos/$(request.resource.data.pagoId)).data.pacienteId == request.resource.data.pacienteId
        && getAfter(/databases/$(database)/documents/pagos/$(request.resource.data.pagoId)).data.citaId == request.resource.data.citaId
        && (isAdmin() || isPsychologist(getAfter(/databases/$(database)/documents/pagos/$(request.resource.data.pagoId)).data.psicologoId)
          || request.resource.data.pacienteId == request.auth.uid);
      allow update, delete: if false;
    }

    // Clinical records: patients can see their own; psychologists only the
    // records linked to their UID. Administrators receive operational data,
    // never clinical notes.
    match /atenciones/{atencionId} {
      function citaVinculada(data) {
        let citaPath = /databases/$(database)/documents/citas/$(data.citaId);
        return exists(citaPath)
          && get(citaPath).data.pacienteId == data.pacienteId
          && get(citaPath).data.psicologoId == data.psicologoId;
      }

      allow get, list: if signedIn() && (
        resource.data.pacienteId == request.auth.uid
        || isPsychologist(resource.data.psicologoId)
      );
      allow create: if isPsychologist(request.resource.data.psicologoId)
        && request.resource.data.id == atencionId
        && citaVinculada(request.resource.data)
        && getAfter(/databases/$(database)/documents/citas/$(request.resource.data.citaId)).data.estado == 'COMPLETADA';
      allow update: if isPsychologist(resource.data.psicologoId)
        && request.resource.data.psicologoId == resource.data.psicologoId
        && request.resource.data.pacienteId == resource.data.pacienteId
        && request.resource.data.citaId == resource.data.citaId
        && citaVinculada(request.resource.data)
        && getAfter(/databases/$(database)/documents/citas/$(resource.data.citaId)).data.estado == 'COMPLETADA';
      allow delete: if false;
    }

    match /historiasClinicas/{historiaId} {
      allow get, list: if signedIn() && (
        resource.data.pacienteId == request.auth.uid
        || (isPsychologist(request.auth.uid)
          && request.auth.uid in resource.data.psicologoIds)
      );
      allow create: if isPsychologist(request.resource.data.psicologoIds[0])
        && request.resource.data.psicologoIds.size() == 1
        && request.resource.data.pacienteId is string
        && exists(/databases/$(database)/documents/citas/$(request.resource.data.ultimaCitaId))
        && get(/databases/$(database)/documents/citas/$(request.resource.data.ultimaCitaId)).data.pacienteId == request.resource.data.pacienteId
        && get(/databases/$(database)/documents/citas/$(request.resource.data.ultimaCitaId)).data.psicologoId == request.auth.uid
        && getAfter(/databases/$(database)/documents/citas/$(request.resource.data.ultimaCitaId)).data.estado == 'COMPLETADA';
      allow update: if isPsychologist(request.auth.uid)
        && resource.data.pacienteId == request.resource.data.pacienteId
        && request.auth.uid in request.resource.data.psicologoIds
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'fechaActualizacion', 'psicologoIds', 'ultimaCitaId'
        ])
        && (!resource.data.keys().hasAny(['psicologoIds'])
          || request.resource.data.psicologoIds.hasAll(resource.data.psicologoIds))
        && exists(/databases/$(database)/documents/citas/$(request.resource.data.ultimaCitaId))
        && get(/databases/$(database)/documents/citas/$(request.resource.data.ultimaCitaId)).data.pacienteId == resource.data.pacienteId
        && get(/databases/$(database)/documents/citas/$(request.resource.data.ultimaCitaId)).data.psicologoId == request.auth.uid
        && getAfter(/databases/$(database)/documents/citas/$(request.resource.data.ultimaCitaId)).data.estado == 'COMPLETADA';
      allow delete: if false;
    }

    match /procesosTerapeuticos/{procesoId} {
      allow get, list: if signedIn() && (
        resource.data.pacienteId == request.auth.uid
        || isPsychologist(resource.data.psicologoId)
      );
      allow create: if isPsychologist(request.resource.data.psicologoId)
        && request.resource.data.id == procesoId;
      allow update: if isPsychologist(resource.data.psicologoId)
        && request.resource.data.psicologoId == resource.data.psicologoId
        && request.resource.data.pacienteId == resource.data.pacienteId;
      allow delete: if false;
    }

    match /etapasClinicas/{etapaId} {
      function procesoPadre(procesoId) {
        return get(/databases/$(database)/documents/procesosTerapeuticos/$(procesoId)).data;
      }
      allow get, list: if signedIn() && (
        procesoPadre(resource.data.procesoTerapeuticoId).pacienteId == request.auth.uid
        || isPsychologist(procesoPadre(resource.data.procesoTerapeuticoId).psicologoId)
      );
      allow create: if isPsychologist(getAfter(/databases/$(database)/documents/procesosTerapeuticos/$(request.resource.data.procesoTerapeuticoId)).data.psicologoId)
        && request.resource.data.id == etapaId;
      allow update: if isPsychologist(procesoPadre(resource.data.procesoTerapeuticoId).psicologoId)
        && request.resource.data.procesoTerapeuticoId == resource.data.procesoTerapeuticoId;
      allow delete: if false;
    }

    match /tiposEtapas/{tipoId} {
      allow get, list: if signedIn();
      allow write: if isAdmin();
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
